{
  "defaultBackend": "agy",
  "maxConcurrent": 2,
  "summaryWords": 200,
  "allowedRoots": [],
  "backends": {
    "agy": {
      "command": "agy",
      "args": ["--agent", "offload-reader", "--output-format", "json", "--print-timeout", "{timeoutSec}s", "-p", "{prompt}"],
      "promptVia": "arg",
      "outputJsonPath": "response",
      "usageJsonPath": "usage.total_tokens",
      "timeoutSec": 600
    },
    "claude": {
      "command": "claude",
      "args": ["-p", "--output-format", "json"],
      "promptVia": "stdin",
      "outputJsonPath": "result",
      "timeoutSec": 900
    }
  }
}
